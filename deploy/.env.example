# deploy/.env.example — master template for the deploy/ stack.
# Copy to deploy/.env and fill in every value. NEVER commit the real .env (it
# is gitignored via the root .gitignore `.env` / `.env.*` rules).
#
# This file is read TWICE by docker-compose: (1) Compose auto-loads a file
# named `.env` next to docker-compose.yml for ${VAR} interpolation (the
# ${VAR:?err} guards in docker-compose.yml read from here), and (2) each
# service's `env_file: [.env]` injects every line below into that container's
# process environment. One file, both jobs — do not also create backend/.env
# or microservices/.env for this deploy path, they are not read by
# deploy/docker-compose.yml.
#
# Generate random secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   openssl rand -hex 32

# =============================================================================
# Compose / edge (Caddy, DNS, TLS)
# =============================================================================
# DNS A-record must point at the VM's external IP before first `up` — Caddy
# fetches a Let's Encrypt cert for this automatically on first request.
DOMAIN=your-domain.com
# Email for the Let's Encrypt account (renewal/expiry notices).
ACME_EMAIL=you@example.com

# =============================================================================
# Database — in-stack Postgres (deploy/docker-compose.yml `postgres` service)
# =============================================================================
# Required by the `postgres` service itself; docker-compose.yml refuses to
# start (${VAR:?err}) if this is unset. No default — do not use "maja".
POSTGRES_PASSWORD=
# What the app connects with. Host is the compose service name `postgres`
# (NOT an external VM IP — this stack runs its own Postgres, unlike the old
# microservices/ stack which pointed at a separately-hosted Supabase box).
# Must match POSTGRES_PASSWORD above.
SUPABASE_DB_URL=postgresql://maja:${POSTGRES_PASSWORD}@postgres:5432/maja
DB_POOL_MIN=1
# Overridden to 10 directly in docker-compose.yml's core `environment:` block
# (4 workers x 10 = 40 connections, under Postgres's max_connections=200).
# Setting it here has no effect on `core`; kept for parity with backend/.env.example
# and for any one-off script (e.g. init_super_admin.py) that reads it directly.
DB_POOL_MAX=10

# =============================================================================
# Backups — Postgres (`backup` compose service, deploy/backup-cron-entrypoint.sh)
# =============================================================================
# AES-256 passphrase for the nightly encrypted pg_dump. The `backup` service
# REFUSES TO START without this (see docs/DEPLOYMENT.md §10.5). LOSE THIS AND
# EVERY ENCRYPTED BACKUP IS UNRECOVERABLE — store it in a password manager or
# secret store that survives losing this VM, never only in this file.
BACKUP_PASSPHRASE=
# Local encrypted copies to keep before pruning. Code default is 30 if unset.
BACKUP_RETENTION_DAYS=30
# S3 bucket to mirror media (AWS_S3_BUCKET, below) into — see
# deploy/backup_media.sh. Not read by any running container; that script is
# scheduled via host cron, not docker-compose (docs/DEPLOYMENT.md §10.5).
# Until it's scheduled somewhere, S3 media has NO second copy anywhere.
# MEDIA_BACKUP_BUCKET=

# =============================================================================
# Cache / queue — Redis (persistent — --appendonly yes, see docker-compose.yml)
# =============================================================================
# Fixed to the in-stack service in docker-compose.yml's `environment:` block
# for core/worker; only relevant here for scripts run outside compose.
REDIS_URL=redis://redis:6379/0

# =============================================================================
# Auth / JWT (required)
# =============================================================================
# Strong random secret for legacy HS256 admin tokens (see generator commands
# above). The app REFUSES TO BOOT on the built-in default unless
# ALLOW_INSECURE_JWT=1 — do not set that in production.
JWT_SECRET_KEY=
ALLOW_INSECURE_JWT=0
# Access token TTL, minutes. Code default is 60 if unset.
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Refresh-cookie TTL, days (auth_sessions.py maja_rt cookie).
REFRESH_TOKEN_EXPIRE_DAYS=30
# Event-client token TTL, hours.
CLIENT_TOKEN_EXPIRE_HOURS=24
# Only needed if verifying Supabase-issued JWTs with a shared HS256 secret
# (legacy path) instead of JWKS. Leave unset to use JWKS (ES256/RS256).
SUPABASE_JWT_SECRET=

# =============================================================================
# Environment / mode (required)
# =============================================================================
# "production" enables startup prod-readiness warnings (wildcard CORS, missing
# webhook secret, DEV_MODE_OTP, etc.) AND flips auth_sessions cookies to
# secure=True. Set this in prod — several other flags key off it.
ENVIRONMENT=production
# Skip the "insecure config" prod-readiness checks entirely. Leave 0 in prod;
# only for a deliberately-relaxed staging box.
ALLOW_INSECURE_PROD=0
# Seed test.user@maja.test / test.studio@maja.test with a shared password and
# a free-order (no Razorpay charge) bypass. MUST be 0 in production — the
# legacy default was "on unless explicitly 0" (S2 in recon-security-gaps.md).
SEED_TEST_ACCOUNTS=0
# Only used when SEED_TEST_ACCOUNTS=1 (local/staging only).
TEST_ACCOUNT_PASSWORD=
# OTP dev escape hatch — returns the OTP in the API response when no
# email/SMS provider is configured. Leave 0/unset in production.
DEV_MODE_OTP=0
GEO_LOOKUP_DISABLED=0
# Number of trusted reverse-proxy hops in front of this app. This topology
# runs one (Caddy) directly in front of core, so set this to 1 — otherwise
# rate limiting / abuse locks key off Caddy's IP instead of the real client.
# Code default is 0 (direct exposure) if unset.
#TRUSTED_PROXY_COUNT=1
SEO_BOT_RENDER_DISABLED=0
GANESH_MODULE_ENABLED=1
RAZORPAY_RECURRING_ENABLED=0

# =============================================================================
# CORS / public URLs
# =============================================================================
# Comma-separated allowed origins. NEVER "*" in production — that disables
# credentialed CORS and breaks cookie-based buyer login silently. Use the
# exact scheme+host the SPA is served from.
CORS_ORIGINS=https://yourdomain.com
PUBLIC_BASE_URL=https://yourdomain.com
PUBLIC_BACKEND_URL=https://yourdomain.com
PUBLIC_SITE_URL=https://yourdomain.com
FRONTEND_BASE_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com
# Baked into the SPA at BUILD time (see docs/DEPLOYMENT.md "first deploy").
# Left empty so the SPA calls same-origin /api and Caddy proxies it to core.
REACT_APP_BACKEND_URL=

# =============================================================================
# Super Admin seed (required — no ChangeMe defaults)
# =============================================================================
# Read by backend/init_super_admin.py, run manually as a one-shot after first
# `up` (see docs/DEPLOYMENT.md). Guarded with ${VAR:?err} in docker-compose.yml
# so an unset value fails the deploy instead of silently falling back to the
# script's hardcoded defaults.
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Platform Owner

# =============================================================================
# AI (Google Gemini — love story, translation, notes)
# =============================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# =============================================================================
# Payments (Razorpay)
# =============================================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard -> Settings -> Webhooks. While empty/placeholder, webhook
# events are stored for audit but NEVER credit an account.
RAZORPAY_WEBHOOK_SECRET=
# Razorpay SDK socket timeout, seconds — bounds how long a stalled Razorpay
# endpoint can block the calling request. Code default is 15 if unset.
#RAZORPAY_TIMEOUT=15

# =============================================================================
# Supabase (auth)
# =============================================================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Baked into the SPA at build time.
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key

# =============================================================================
# AWS (S3 media + CloudFront signed URLs + Rekognition) — see DEPLOYMENT.md
# =============================================================================
# Leave both EMPTY if the host provides credentials another way — an instance
# role/profile, or a mounted ~/.aws dir (see deploy/docker-compose.yml's
# commented AWS_SHARED_CREDENTIALS_DIR volume mount on the core/worker
# services). backend/aws_service.py treats an empty string as "absent", not
# as a credential, and falls through to boto3's normal provider chain
# (env -> shared config/profile -> container/instance role) — never leave
# these set to a placeholder string, only truly empty or a real key pair.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Selects a profile from a mounted ~/.aws (see the volume-mount comment in
# docker-compose.yml above). Leave unset/commented for the default provider
# chain — do NOT set this to an empty string, botocore treats a
# present-but-empty AWS_PROFILE as a request for a profile literally named ""
# and raises ProfileNotFound.
#AWS_PROFILE=
AWS_REGION=us-east-2
# DEPRECATED / legacy-only: the pre-four-bucket single media bucket. Modules
# written before the four-bucket split (gallery_features, studio_storage,
# storage_upload, media_reconcile, auto_moderation, …) still fall back to this
# when AWS_S3_EVENT_BUCKET is unset (see aws_service.bucket()) — everything
# else uses the four canonical buckets below. Can be omitted entirely once
# all four are set.
AWS_S3_BUCKET=
# Canonical four-bucket media storage (region us-east-2 in production) — see
# docs/MEDIA_STORAGE.md and backend/.env.example's "Canonical media storage"
# section for the full resolution order. face never falls back to
# AWS_S3_BUCKET above (biometric selfies must never silently land in a
# shared bucket).
AWS_S3_PORTFOLIO_BUCKET=maja-portfolio-media-2026
AWS_S3_EVENT_BUCKET=maja-event-media-2026
AWS_S3_INVITATIONS_BUCKET=maja-invitations-media-2026
AWS_S3_FACE_BUCKET=maja-face-private-2026
# S3 Transfer Acceleration for browser gallery uploads. When on, the gallery
# presign PUT uses <bucket>.s3-accelerate.amazonaws.com so a distant uploader
# (e.g. India -> us-east-2) transfers through the nearest AWS edge instead of
# straight to Ohio. ENABLE ON THE BUCKET FIRST, then set this — the accelerate
# endpoint errors for a bucket without acceleration, which would break uploads.
#   aws s3api put-bucket-accelerate-configuration \
#     --bucket maja-event-media-2026 --accelerate-configuration Status=Enabled
# Only the event bucket is wired for it (that is where gallery photos land).
#AWS_S3_ACCELERATE=true
STORAGE_DEFAULT_PROVIDER=s3
AWS_CLOUDFRONT_DOMAIN=
AWS_CLOUDFRONT_KEY_PAIR_ID=
# Path INSIDE the core container (repo is bind-mounted to /app). Confirm this
# file is never committed — SECRET ROTATION CHECKLIST in DEPLOYMENT.md.
AWS_CLOUDFRONT_PRIVATE_KEY_PATH=/app/backend/aws_cloudfront_private_key.pem
# Google Drive auto-archive (studio cloud backup). Optional feature; disabled
# gracefully when 0 or when Drive isn't configured.
DRIVE_ARCHIVE_ENABLED=0

# --- AWS smoke-test AUDIT profile (optional, NOT application credentials) ----
# scripts/aws_smoke_test.py splits its checks in two:
#   RUNTIME  - uses the application identity (maja-backend). Must always pass.
#   AUDIT    - reads bucket CONFIGURATION (region, encryption, public-access
#              block, CORS). Needs s3:GetBucketLocation /
#              GetEncryptionConfiguration / GetBucketPublicAccessBlock /
#              GetBucketCORS, which the runtime role deliberately does NOT
#              hold - the application never makes those calls.
# Set this to a separate READ-ONLY named profile to run the audit lane. Leave
# it unset and audit checks report SKIP-AUDIT (never FAIL). This is a profile
# NAME resolved from the AWS config file, never a key - no secret goes here.
# AWS_SMOKE_AUDIT_PROFILE=maja-audit

# =============================================================================
# Camera SFTP transfer (docs/CAMERA_SFTP.md) — optional overlay service
# =============================================================================
# Only needed if you run deploy/docker-compose.camera.yml. No secret here: the
# camera password is per-event, bcrypt-hashed, and shown once in the panel.
# CAMERA_SFTP_HOST=ftp.majainvites.com   # what the photographer types (needs a DNS A record -> VM)
# CAMERA_SFTP_PORT=2222                  # SFTP port shown to the photographer (match the published port)
# CAMERA_SFTP_BIND_PORT=22               # SFTP port inside the container (overlay publishes it as 2222)
# CAMERA_CRED_TTL_DAYS=120               # credential lifetime before it must be rotated
# CAMERA_SFTP_AUTH_MAX_PER_MIN=20        # per-IP auth attempt throttle
# CAMERA_MAX_UPLOAD_BYTES=83886080       # 80 MB per-file ceiling
#
# FTPES (Sony a7 IV and other FTP cameras — they don't do SFTP):
# CAMERA_FTPS_PORT=21                    # FTPES control port shown to the photographer
# CAMERA_FTPS_MASQUERADE_ADDRESS=34.67.38.190   # REQUIRED: the VM's PUBLIC ip (passive data uses it)
# CAMERA_FTPS_PASV_MIN=30000             # passive-port range start (open these in the firewall too)
# CAMERA_FTPS_PASV_MAX=30009             # passive-port range end

# =============================================================================
# Google OAuth client (Google Cloud Console)
# =============================================================================
# ONE OAuth client serves both normal-user login AND Drive auto-archive.
# Register BOTH redirect URIs below on this client in the console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must equal <PUBLIC_BASE_URL>/api/users/auth/google/callback. Derived from
# PUBLIC_BASE_URL if unset.
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_DRIVE_REDIRECT_URI=
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file
GOOGLE_SA_CREDENTIALS_FILE=
GOOGLE_SA_CREDENTIALS_JSON=
GOOGLE_SA_SUBJECT=

# =============================================================================
# Maps (optional)
# =============================================================================
WHAT3WORDS_API_KEY=

# =============================================================================
# Email (transactional: receipts, password reset, gallery-ready)
# =============================================================================
# Provider auto-selected: resend (if RESEND_API_KEY) -> smtp -> dev (log+outbox).
# Force with EMAIL_PROVIDER=resend|smtp|dev.
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_FROM_NAME=MAJA Invites
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS=true

# =============================================================================
# SMS / WhatsApp / push (optional)
# =============================================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=
FCM_SERVER_KEY=
EVENT_PUSH_PROVIDER=
EVENT_SMS_PROVIDER=
EVENT_WHATSAPP_PROVIDER=

# =============================================================================
# Storage / media / uploads
# =============================================================================
UPLOADS_ROOT=
UPLOAD_PRESIGN_TTL=
MEDIA_SIGNED_URL_TTL=
STORAGE_CRED_KEY=
STORAGE_COST_INR_PER_GB=
BACKUP_DEFAULT_GB=
GALLERY_BULK_CONCURRENCY=
FACE_MATCH_CONFIDENCE_THRESHOLD=

# =============================================================================
# Jobs / pricing
# =============================================================================
EXPIRY_SWEEP_INTERVAL_SECONDS=3600
LINK_REACTIVATION_INR_PER_DAY=
LIVE_UPLOAD_TOKEN_EXPIRY_HOURS=
DELIVERY_WEBHOOK_SECRET=

# Per-call cost assumption (INR) for Rekognition face ops, used only by the
# admin profitability estimate (profitability.py / usage_metering.py). Not a
# real AWS bill lookup — a labelled, auditable estimate. Code default 0.10.
#REKOGNITION_COST_INR=0.10

# =============================================================================
# GST invoicing
# =============================================================================
INVOICE_SELLER_NAME=MAJA Invites
INVOICE_SELLER_GSTIN=
INVOICE_SELLER_ADDRESS=
# Seller state — used to decide CGST+SGST (intra-state) vs IGST (inter-state).
INVOICE_SELLER_STATE=
INVOICE_PREFIX=MAJA
# HSN/SAC for the service (998431 = online information services).
INVOICE_HSN_SAC=998431
GST_RATE=18

# =============================================================================
# Observability
# =============================================================================
# Sentry DSN (backend + frontend). No-op (silently disabled) when unset — but
# that means zero crash reporting in prod (M4 in recon-security-gaps.md §11).
# Set this before go-live.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# =============================================================================
# Request limits
# =============================================================================
# Global JSON body-size cap, bytes (enforced by BodySizeLimitMiddleware in
# security_middleware.py, checked against the request's Content-Length
# header before the route handler reads the body). Default 2 MiB if unset.
# multipart/form-data requests are exempt — file uploads keep their own
# per-endpoint size caps and are streamed, not buffered as JSON.
MAX_JSON_BODY_BYTES=2097152

# =============================================================================
# Frontend build-only (not read by any running container — consumed by
# `yarn build`, see docs/DEPLOYMENT.md "first deploy")
# =============================================================================
# Never emit .js.map in the production bundle — they expose full source.
GENERATE_SOURCEMAP=false
NODE_OPTIONS=--max_old_space_size=2048

# frontend-v2 (Vite) build-time vars — baked into the bundle by `yarn build`,
# not read at container runtime. See docs/DEPLOYMENT.md "first deploy".
# Backend origin the SPA calls. Empty = same-origin (Caddy proxies /api to
# core) — the correct value for this deploy topology.
#VITE_BACKEND_URL=
# Optional CDN base for design-catalogue artwork. Unset falls back to the
# backend origin, which already serves /uploads/* directly.
#VITE_DESIGN_CDN=
# Real, staffed WhatsApp Business number (bare digits, e.g. 91XXXXXXXXXX) for
# the "WhatsApp us" support CTA on Landing/Faq/Contact. MUST be a monitored
# line — never a placeholder. Unset hides the WhatsApp CTA in favor of /contact.
#VITE_SUPPORT_WHATSAPP=

# --- External-service timeouts (2026-08-17 hardening; all optional) ---
# boto3 S3/Rekognition socket timeouts (seconds)
#AWS_CONNECT_TIMEOUT=5
#AWS_READ_TIMEOUT=60
# asyncpg per-statement timeout (seconds; index builds use their own 600s cap)
#PG_COMMAND_TIMEOUT=30
# Redis operation timeout (seconds; connect timeout stays 2)
#REDIS_SOCKET_TIMEOUT=5
# Gemini generation deadline (seconds)
#GEMINI_TIMEOUT_SECONDS=45
