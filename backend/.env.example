# backend/.env.example — copy to backend/.env and fill in real values.
# NEVER commit the real .env (it is gitignored). Rotate any key that leaks.
# Variable names below match what backend/*.py actually reads.
#
# ONLY TWO of these are required for the server to BOOT:
#   • SUPABASE_DB_URL — server.py:170 raises at import if unset
#   • JWT_SECRET_KEY  — auth.py:41 refuses to start if unset
# Everything else is feature-scoped: leave it blank and that one feature turns
# itself off. Nothing else crashes.

# --- Database (REQUIRED TO BOOT) — Postgres-only (self-hosted Supabase). ---
# SUPABASE_DB_URL=postgresql://postgres:PASS@VM_IP:5432/postgres
# Local via run.ps1 (Postgres listens on 5433, NOT 5432):
#   postgresql://postgres:postgres@localhost:5433/postgres
SUPABASE_DB_URL=
DB_POOL_MIN=1
DB_POOL_MAX=20

# --- CORS ---
# Comma-separated allowed origins. Use explicit frontend origin(s) in production,
# e.g. "https://app.example.com". "*" disables credentialed CORS (safe for the
# bearer-token API).
CORS_ORIGINS="*"

# --- Auth (REQUIRED TO BOOT) ---
# Strong random secret for HS256 admin tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app REFUSES TO START if this is unset — the built-in fallback would make
# admin tokens forgeable (auth.py:41).
JWT_SECRET_KEY=

# Local-dev-only escape hatch: boot with the insecure built-in secret instead
# of setting JWT_SECRET_KEY. NEVER set this outside local dev / tests.
# ALLOW_INSECURE_JWT=1

# Set to "production" to enable startup prod-readiness warnings (logs any
# insecure config: wildcard CORS, missing webhook secret, DEV_MODE_OTP, etc.).
ENVIRONMENT=

# --- Scale / abuse control (optional) ---
# Redis backs rate limiting across multiple workers/replicas. If unset, limits
# fall back to per-process in-memory (fine for the single worker the app ships).
# In docker-compose this is set automatically to the in-stack redis service.
REDIS_URL=
# OTP dev escape hatch. When 1 AND no email/SMS provider is configured, the code
# is returned in the API RESPONSE so signup works locally. It now DEFAULTS TO OFF
# (it used to default on, which silently made the OTP gate meaningless on any
# production box without a provider — the caller was handed the code).
# Leave this unset/0 in production. With it off and no provider configured,
# /auth/send-otp returns 503 instead of pretending the code was sent.
DEV_MODE_OTP=0
# Set to 1 to fully disable the per-view ipapi.co geo lookup under heavy load.
GEO_LOOKUP_DISABLED=
# Number of trusted reverse-proxy hops in front of this app (e.g. Caddy/LB).
# 0 (default) = direct exposure, ignore X-Forwarded-For, use the raw TCP peer
# IP. Set to 1 behind a single reverse proxy so rate limiting / abuse locks
# key off the real client IP instead of the proxy's.
#TRUSTED_PROXY_COUNT=0

# --- AI (Google Gemini, direct API — powers love story, translation, notes) ---
GEMINI_API_KEY=
# Optional model override (default: gemini-2.5-flash)
GEMINI_MODEL=

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret (Razorpay Dashboard → Settings → Webhooks).
# While empty/placeholder, the webhook is stored for audit but will NOT credit.
RAZORPAY_WEBHOOK_SECRET=
# Razorpay SDK socket timeout, seconds — bounds how long a stalled Razorpay
# endpoint can block the calling request. Code default is 15 if unset.
#RAZORPAY_TIMEOUT=15

# --- Supabase (auth) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AWS (S3 media + CloudFront signed URLs + Rekognition) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
AWS_S3_BUCKET=
AWS_CLOUDFRONT_DOMAIN=
AWS_CLOUDFRONT_KEY_PAIR_ID=
AWS_CLOUDFRONT_PRIVATE_KEY_PATH=/app/backend/aws_cloudfront_private_key.pem

# --- Google OAuth client (Google Cloud Console) ---
# NOTE: normal-user (couple) Google sign-in was PERMANENTLY RETIRED — those
# endpoints answer 410 NORMAL_USERS_RETIRED and GOOGLE_OAUTH_REDIRECT_URI no
# longer serves a live flow. This client now exists only for Drive
# auto-archive (studio cloud backup) and the multi-drive storage pool.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Drive Auto-Archive (studio cloud backup, optional, scope drive.file).
# If unset, that feature is disabled gracefully.
GOOGLE_DRIVE_REDIRECT_URI=
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file

# Service-account credentials for the multi-drive storage pool (flag-gated,
# default OFF). Provide ONE of file path or inline JSON.
# GOOGLE_SA_CREDENTIALS_FILE=
# GOOGLE_SA_CREDENTIALS_JSON=
# GOOGLE_SA_SUBJECT=

# Encrypts stored provider credentials at rest. Set before enabling the pool.
# STORAGE_CRED_KEY=
# STORAGE_DEFAULT_PROVIDER=
# STORAGE_COST_INR_PER_GB=

# --- Public URLs ---
# Public site origin (used for QR links, OAuth redirect derivation, OG tags).
PUBLIC_BASE_URL=
# Where to bounce the browser after Google login completes. Defaults to
# FRONTEND_URL / PUBLIC_BASE_URL if unset.
FRONTEND_BASE_URL=

# --- Maps (optional) ---
# Enables What3Words address support in map_features.py.
WHAT3WORDS_API_KEY=

# --- Email (transactional: receipts, password reset, gallery-ready) ---
# Provider auto-selected: resend (if RESEND_API_KEY) -> smtp -> dev (log+outbox).
# Force with EMAIL_PROVIDER=resend|smtp|dev.
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_FROM_NAME=MAJA Invites
# Resend (https://resend.com)
RESEND_API_KEY=
# SMTP (any provider: Zoho, Gmail app-password, SES SMTP, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS=true

# --- Frontend base URL (for links in emails: password reset, gallery, invoices) ---
# Local dev is Vite on :8127 (run.ps1). :3000/:3100 was the retired CRA app.
FRONTEND_URL=http://localhost:8127

# --- SMS / WhatsApp / push (all optional) ---
# Unset → the notification is skipped and logged; nothing errors.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
FCM_SERVER_KEY=
# Force a specific provider for the event notification fan-out.
# EVENT_SMS_PROVIDER=
# EVENT_WHATSAPP_PROVIDER=
# EVENT_PUSH_PROVIDER=

# --- Observability / misc (optional) ---
# Error tracking. Unset → disabled.
SENTRY_DSN=
# Face-match provider selector. Unset → the default provider is used.
FACE_MATCH_PROVIDER=
# Ganesh celebration module toggle.
GANESH_MODULE_ENABLED=

# Per-call cost assumption (INR) for Rekognition face ops, used only by the
# admin profitability estimate (profitability.py / usage_metering.py). Not a
# real AWS bill lookup — a labelled, auditable estimate. Code default 0.10.
#REKOGNITION_COST_INR=0.10

# --- GST invoicing ---
INVOICE_SELLER_NAME=MAJA Invites
INVOICE_SELLER_GSTIN=
INVOICE_SELLER_ADDRESS=
# Seller state — used to decide CGST+SGST (intra) vs IGST (inter-state).
INVOICE_SELLER_STATE=
INVOICE_PREFIX=MAJA
# HSN/SAC for the service (998431 = online information services).
INVOICE_HSN_SAC=998431
GST_RATE=18

# --- External-service timeouts (2026-08-17 hardening; all optional) ---
# boto3 S3/Rekognition socket timeouts (seconds)
#AWS_CONNECT_TIMEOUT=5
#AWS_READ_TIMEOUT=60
# asyncpg per-statement timeout (seconds; index builds use their own 600s cap)
#PG_COMMAND_TIMEOUT=30
# Redis operation timeout (seconds; connect timeout stays 2)
#REDIS_SOCKET_TIMEOUT=5
# Gemini generation deadline (seconds)
#GEMINI_TIMEOUT_SECONDS=45

# --- Canonical media storage (4 buckets) ---
# Four private, per-purpose S3 buckets (region us-east-2 in production) that
# replace the single AWS_S3_BUCKET above for new media. Routing + key layout:
# backend/media_storage.py. Resolution order per category (aws_service.py):
# this canonical name -> the deprecated S3_BUCKET_<CAT> alias (still accepted,
# logs a warning) -> AWS_S3_BUCKET above — so a single-bucket dev/test deploy
# keeps working unchanged. EXCEPT face: it never falls back to AWS_S3_BUCKET
# (biometric selfies must never silently land in a shared media bucket) — if
# AWS_S3_FACE_BUCKET/S3_BUCKET_FACE are both unset, face uploads are disabled,
# not redirected. Set these only when the four buckets actually exist. See
# docs/MEDIA_STORAGE.md.
# AWS_S3_PORTFOLIO_BUCKET=maja-portfolio-media-2026
# AWS_S3_EVENT_BUCKET=maja-event-media-2026
# AWS_S3_INVITATIONS_BUCKET=maja-invitations-media-2026
# AWS_S3_FACE_BUCKET=maja-face-private-2026

# --- Camera SFTP transfer (docs/CAMERA_SFTP.md) ------------------------------
# Only used by backend/camera_sftp_server.py (the optional SFTP daemon). No
# secret: the per-event camera password is bcrypt-hashed and shown once.
# CAMERA_SFTP_HOST=ftp.majainvites.com
# CAMERA_SFTP_PORT=2222
# CAMERA_SFTP_BIND_PORT=2222
# CAMERA_CRED_TTL_DAYS=120
# CAMERA_SFTP_AUTH_MAX_PER_MIN=20
# CAMERA_MAX_UPLOAD_BYTES=83886080
# FTPES (Sony a7 IV): CAMERA_FTPS_PORT=21, CAMERA_FTPS_MASQUERADE_ADDRESS=<public ip>,
# CAMERA_FTPS_PASV_MIN=30000, CAMERA_FTPS_PASV_MAX=30009

# --- AWS smoke-test AUDIT profile (optional, NOT application credentials) ----
# scripts/aws_smoke_test.py splits its checks in two:
#   RUNTIME  - uses the application identity (maja-backend). Must always pass.
#   AUDIT    - reads bucket CONFIGURATION (region, encryption, public-access
#              block, CORS). Needs s3:GetBucketLocation /
#              GetEncryptionConfiguration / GetBucketPublicAccessBlock /
#              GetBucketCORS, which the runtime role deliberately does NOT
#              hold - the application never makes those calls.
# Set this to a separate READ-ONLY named profile to run the audit lane. Leave
# it unset and audit checks report SKIP-AUDIT (never FAIL). This is a profile
# NAME resolved from the AWS config file, never a key - no secret goes here.
# AWS_SMOKE_AUDIT_PROFILE=maja-audit

# Per-file byte ceilings (env-tunable; large files go browser->S3 directly and
# never transit the app server, so these protect quotas, not the VM).
#MEDIA_MAX_IMAGE_BYTES=209715200        # 200 MB (also covers thumbnails)
#MEDIA_MAX_VIDEO_BYTES=68719476736      # 64 GiB
#MEDIA_MAX_AUDIO_BYTES=1073741824       # 1 GiB
#MEDIA_MAX_MUSIC_BYTES=209715200        # 200 MB

# Aggregate quotas, enforced at upload-session creation from media_assets.
#MEDIA_EVENT_QUOTA_BYTES=3298534883328        # 3 TiB per event
#MEDIA_PHOTOGRAPHER_QUOTA_BYTES=5497558138880 # 5 TiB per photographer

# Multipart tuning. Files at/above this size use S3 multipart upload instead
# of a single presigned PUT. S3's own minimum part size (5 MiB) and part cap
# (10,000 parts) are protocol limits, not env-tunable.
#MEDIA_MULTIPART_THRESHOLD_BYTES=33554432   # 32 MB

# Upload-session lifetime: sliding idle window + absolute ceiling. A session
# past either is treated as abandoned/expired and swept (see docs/MEDIA_STORAGE.md).
#MEDIA_UPLOAD_IDLE_HOURS=6
#MEDIA_UPLOAD_ABSOLUTE_HOURS=48

# Abuse guards on the control plane (never on the S3 transfer itself).
#MEDIA_MAX_ACTIVE_SESSIONS=200
#MEDIA_SESSION_RATE_PER_HOUR=2000

# Public-invitation view budget per IP per rolling 24h (default 500). Raise on
# a dev box — repeated test runs from 127.0.0.1 exhaust the default in a day.
INVITE_VIEW_LIMIT_PER_DAY=
