# Root .env — read by docker-compose for variable substitution + frontend build.
# Copy to .env and fill in. (backend secrets live separately in backend/.env)
#   cp .env.example .env

# Your domain (DNS A-record must point at the VM's external IP). Caddy fetches
# a Let's Encrypt cert for this automatically.
DOMAIN=your-domain.com

# Email for the Let's Encrypt account (renewal notices).
ACME_EMAIL=you@example.com

# Supabase (public) values — baked into the frontend bundle at build time.
# For testing: your cloud Supabase project. Later: your self-hosted Supabase URL.
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key

# Note: REACT_APP_BACKEND_URL is intentionally fixed to "" in docker-compose.yml
# so the SPA calls same-origin /api (Caddy proxies it to the backend).
